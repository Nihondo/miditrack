{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos-universal",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/.cache/spc2midi/build/macos-universal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "FETCHCONTENT_BASE_DIR": "$env{HOME}/.cache/spc2midi/_deps"
      }
    },
    {
      "name": "macos-arm64",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/.cache/spc2midi/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "FETCHCONTENT_BASE_DIR": "$env{HOME}/.cache/spc2midi/_deps"
      }
    },
    {
      "name": "macos-x86_64",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/.cache/spc2midi/build/macos-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "FETCHCONTENT_BASE_DIR": "$env{HOME}/.cache/spc2midi/_deps"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64"
    }
  ]
}

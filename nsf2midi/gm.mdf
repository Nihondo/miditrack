[TRIANGELE-CHANNEL]
; GM 39 Synth Bass 1 (0-based Instrument=38)。三角波はベースライン用途が
; 大半のため、原本のリード系デフォルト(80)よりベース系音色の方が実態に合う。
; LevelChangeEnabled/AttackEnabled/DecayEnabled/Velocity は明示していない —
; MdfFile のコンストラクタが Triangle スロットの既定値を無効化済み
; (STATE_VOLUME が線形カウンタで音量ではないため。CLAUDE.md 参照)。
Instrument=38
BankHi=0
BankLo=0
Reverb=0
Chorus=0
Volume=127
PitchBendEnabled=1
ChannelEnabled=1
MonoEnabled=0
PortamentEnabled=0
NoteNumberAdjust=0
[NOISE-CHANNEL]
; Instrument はマップ無効時のフォールバックとしてのみ使われる
; (NoiseDrumMapEnabled=1 なので通常は周期+LFSRモードから42/38/45/37を選ぶ)。
; AbsoluteDividedPoint は原本の 7 から 1 に下げ、弱いハイハットも Velocity=1 で
; 強弱表現できるようにした。LevelChangeEnabled=1 で音量急上昇によるロール
; 再トリガーも有効化。
Instrument=42
BankHi=0
BankLo=0
AttackEnabled=1
DecayEnabled=1
Velocity=1
Volume=110
RelativeDividedPoint=4
AbsoluteDividedPoint=1
FrequencyChangeEnabled=1
LevelChangeEnabled=1
ChannelEnabled=1
NoiseDrumMapEnabled=1
[PCM-CHANNEL]
; Velocity は明示していない -- DPCM トリガーは常に ComputeVelocity(127) 固定で
; 呼ばれる (detector.cpp) ため、Velocity=1 にしても効果がない。
Instrument=36
BankHi=0
BankLo=0
Volume=110
ChannelEnabled=1
PcmSampleMapEnabled=1

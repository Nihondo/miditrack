#!/usr/bin/env bash
# Copy this file to release_credentials.sh. That filename is ignored by Git.
# Store only the Keychain profile name here; never put an Apple ID password or
# App Store Connect private key in this repository.

export MIDITRACK_SIGNING_IDENTITY='Developer ID Application: Your Name (TEAMID)'
export MIDITRACK_NOTARY_PROFILE='miditrack-notary'
